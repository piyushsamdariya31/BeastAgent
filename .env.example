# Copy to .env and fill in
ANTHROPIC_API_KEY=your-key
# Models: leave these out and pick a model inside Beast (Auto is the default). Optional overrides for what Auto uses:
# FAST_MODEL=claude-haiku-4-5-20251001
# MODEL=claude-sonnet-5-5
# BUILD_MODEL=claude-opus-5-5

# Email (IMAP). For Gmail: enable 2-step verification, then create an App Password.
IMAP_HOST=imap.gmail.com
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Short description of you, so "worth my time" is judged against your goals
MY_CONTEXT=CSE student at BMS College of Engineering. Interested in internships, product building, game dev, and my ongoing projects. Deadlines and people I know matter most.

# Optional
DRAFTS_FOLDER=[Gmail]/Drafts
BEAST_PORT=8765

# More inboxes: run `python main.py add-account` (repeat for each). Stored in accounts.json.
# Where generated projects are created (default ~/BeastProjects)
# BEAST_WORKSPACE=

# Daily digest and watching
# BEAST_WATCHLIST=NIFTY,SENSEX,RELIANCE.NS
# BEAST_NEWS_TOPICS=technology, AI and startups
# Discord bot for your own server
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# Image generation (separate service)
# IMAGE_API_KEY=
# Other: BEAST_MUSIC=off, BEAST_HEADLESS=1, BEAST_DOCS=, BEAST_IMAGES=

# Greeting
# BEAST_NAME=Piyush
# Studio (building websites and apps)
# BUILD_MAX_TOKENS=32000
# BEAST_PREVIEW_PORT=8766

# The Pack: how many agents may work at once (1 to 8)
# BEAST_MAX_AGENTS=4
# Browser for website tasks: chrome, msedge or chromium (default: the first one installed)
# BEAST_BROWSER=chrome
# Or attach to a Chrome you started with --remote-debugging-port=9222
# BEAST_CDP_URL=http://127.0.0.1:9222
